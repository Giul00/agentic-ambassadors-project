# Copiar este archivo como .env (en la raíz del proyecto) y completar los valores.
# .env está ignorado por git: NUNCA lo subas ni pegues su contenido en chats.
# Lo que define .env reemplaza a las variables de la terminal. Las líneas vacías se ignoran.

# --- AWS (Bedrock para los agentes; despliegue solo con DELIVERY_CREW_DEPLOY=1) ---
# Credenciales temporales del workshop (Workshop Studio -> Get AWS CLI credentials). Vencen en horas.
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Alternativa a las claves: un perfil de ~/.aws/config (por ejemplo, IAM Identity Center).
# AWS_PROFILE=

# --- GitHub (abrir y mergear PRs en el repo de la demo) ---
# Token fine-grained solo para ese repo: Contents y Pull requests en "Read and write".
GITHUB_TOKEN=

# --- Delivery Crew ---
# Cuenta de destino del plan de despliegue (por defecto, la de las credenciales activas).
# DELIVERY_CREW_TARGET_ACCOUNT=123456789012
# 1 para desplegar de verdad al aprobar el plan (requiere permisos completos en la cuenta).
DELIVERY_CREW_DEPLOY=0
# Dueños de GitHub permitidos para clonar (separados por coma).
DELIVERY_CREW_GITHUB_OWNERS=Giul00,tomasdemarco
# Repo que el panel propone por defecto.
DELIVERY_CREW_DEMO_REPO=https://github.com/tomasdemarco/api-demo-agentic-ambassadors
